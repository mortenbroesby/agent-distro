{
  "name": "agent-distro",
  "version": "0.0.0",
  "bin": {
    "agent-distro": "bin/agent-distro.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-catalog.mjs",
    "assets:check": "node scripts/generate-catalog.mjs --check",
    "build": "npm run assets:generate && tsdown src/agent-distro.ts --format esm --out-dir dist --copy assets",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && npm run assets:check && vitest run --no-file-parallelism --exclude .agents/**",
    "test:proof": "npm run build && node test/proof.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "execa": "^9.6.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  }
}
