#!/usr/bin/env bash

# Format exactly the files selected for this commit, then restage their changes.
# Git Bash and macOS both provide Bash and Git's NUL-delimited file list.
set -euo pipefail

while IFS= read -r -d '' file; do
  case "$file" in
    *.cjs | *.js | *.json | *.jsx | *.mjs | *.ts | *.tsx)
      ./node_modules/.bin/oxfmt "$file"
      git add -- "$file"
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
